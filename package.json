{
  "name": "pokedex-field-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A Pokémon field guide with 1,025 Pokémon, login-free team building, all-generation team showcases, shiny artwork, type filters, and day/night themes. Built with React and Vite.",
  "repository": {
    "type": "git",
    "url": "https://github.com/PRABHMANNAT/Pokedex.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "data:sync": "node scripts/sync-catalog.mjs",
    "data:forms": "node scripts/sync-pick-forms.mjs",
    "format": "prettier --write src scripts tests *.js *.json *.html *.md .github"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "prettier": "^3.8.3",
    "vite": "^8.3.3"
  }
}
